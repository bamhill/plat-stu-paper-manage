{
  "name": "stu-manage",
  "version": "0.19.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-platshared.mjs && node scripts/init-deployment.mjs && next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/check-platshared.mjs && node scripts/init-deployment.mjs && next start",
    "setup": "node scripts/check-platshared.mjs && prisma generate && node scripts/init-deployment.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "restore-attachments": "node scripts/restore-attachments.mjs",
    "verify:all": "npm run verify",
    "check:shared": "node scripts/check-platshared.mjs",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "lucide-react": "^1.14.0",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "prisma": "^5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.75.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
