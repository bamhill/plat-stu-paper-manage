generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Teacher {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  students     Student[]
  attachments  Attachment[]
  settings     TeacherSetting?
  promptTemplates PromptTemplate[]
  aiTaskRuns      AiTaskRun[]

  @@map("teachers")
}

model TeacherSetting {
  id         Int      @id @default(autoincrement())
  teacherId  Int      @unique @map("teacher_id")
  configJson String   @map("config_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("teacher_settings")
}

model Student {
  id              Int       @id @default(autoincrement())
  teacherId       Int       @map("teacher_id")
  name            String
  studentNo       String    @map("student_no")
  degreeType      String    @map("degree_type")
  enrollmentYear  Int       @map("enrollment_year")
  graduationYear  Int?      @map("graduation_year")
  direction       String
  supervisor      String
  coSupervisor    String?   @map("co_supervisor")
  status          String    @default("active")
  showOnDashboard Boolean   @default(true) @map("show_on_dashboard")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  teacher         Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  papers          Paper[]
  theses          Thesis[]
  timelineEvents  TimelineEvent[]
  transfersFrom   PaperResponsibilityTransfer[] @relation("TransferFrom")
  transfersTo     PaperResponsibilityTransfer[] @relation("TransferTo")

  @@unique([teacherId, studentNo])
  @@index([teacherId, status])
  @@map("students")
}

model Paper {
  id                   Int       @id @default(autoincrement())
  studentId            Int       @map("student_id")
  title                String
  paperType            String    @map("paper_type")
  direction            String
  firstAuthor          String    @map("first_author")
  correspondingAuthor  String    @map("corresponding_author")
  status               String    @default("writing")
  targetVenue          String?   @map("target_venue")
  currentVersion       Int       @default(1) @map("current_version")
  versionLabel         String?   @map("version_label")
  isPriority           Boolean   @default(false) @map("is_priority")
  priorityOrder        Int?      @map("priority_order")
  notes                String?
  myThoughts           String?   @map("my_thoughts")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  versions       PaperVersion[]
  submissions    Submission[]
  responsibilityTransfers PaperResponsibilityTransfer[]
  aiTaskRuns     AiTaskRun[]

  @@index([studentId, status])
  @@index([isPriority, priorityOrder])
  @@map("papers")
}

model PaperVersion {
  id            Int      @id @default(autoincrement())
  paperId       Int      @map("paper_id")
  versionNumber Int      @map("version_number")
  fileName      String   @map("file_name")
  filePath      String   @map("file_path")
  fileSize      Int      @map("file_size")
  description   String?
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@map("paper_versions")
}

model Submission {
  id                   Int       @id @default(autoincrement())
  paperId              Int       @map("paper_id")
  venueName            String    @map("venue_name")
  submissionRound      Int       @map("submission_round")
  manuscriptNo         String?   @map("manuscript_no")
  manuscriptTitle      String?   @map("manuscript_title")
  firstAuthor          String?   @map("first_author")
  correspondingAuthor String?   @map("corresponding_author")
  responsibleStudentName String? @map("responsible_student_name")
  responsibleStudentNo   String? @map("responsible_student_no")
  submittedAt          DateTime? @map("submitted_at")
  underReviewAt        DateTime? @map("under_review_at")
  decisionAt           DateTime? @map("decision_at")
  decision             String?
  editorComments       String?   @map("editor_comments")
  reviewerComments     String?   @map("reviewer_comments")
  status               String    @default("pending")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  paper      Paper       @relation(fields: [paperId], references: [id], onDelete: Cascade)
  revisions  Revision[]
  aiTaskRuns AiTaskRun[]

  @@index([paperId, submissionRound])
  @@map("submissions")
}

model Revision {
  id               Int       @id @default(autoincrement())
  submissionId     Int       @map("submission_id")
  revisionRound    Int       @map("revision_round")
  receivedAt       DateTime? @map("received_at")
  dueAt            DateTime? @map("due_at")
  submittedAt      DateTime? @map("submitted_at")
  revisionType     String    @map("revision_type")
  commentsSummary  String?   @map("comments_summary")
  responseSummary  String?   @map("response_summary")
  status           String    @default("pending")
  notes             String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  submission  Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  aiTaskRuns  AiTaskRun[]

  @@map("revisions")
}

model Thesis {
  id             Int       @id @default(autoincrement())
  studentId      Int       @map("student_id")
  title          String
  degreeType     String    @map("degree_type")
  stage          String    @default("proposal")
  proposalDate   DateTime? @map("proposal_date")
  midtermDate    DateTime? @map("midterm_date")
  submittedAt    DateTime? @map("submitted_at")
  reviewedAt     DateTime? @map("reviewed_at")
  defenseDate    DateTime? @map("defense_date")
  score          String?
  expert1Score   String?   @map("expert1_score")
  expert2Score   String?   @map("expert2_score")
  expert3Score   String?   @map("expert3_score")
  reviewComments String?   @map("review_comments")
  revisionNotes  String?   @map("revision_notes")
  status         String    @default("in_progress")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviews     ThesisReview[]

  @@map("theses")
}

model ThesisReview {
  id           Int       @id @default(autoincrement())
  thesisId     Int       @map("thesis_id")
  reviewerName String    @map("reviewer_name")
  reviewerType String    @map("reviewer_type")
  score        String?
  decision     String
  comments     String?
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  thesis      Thesis       @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  @@map("thesis_reviews")
}

model Attachment {
  id          Int      @id @default(autoincrement())
  teacherId   Int      @map("teacher_id")
  relatedType String   @map("related_type")
  relatedId   Int      @map("related_id")
  fileName    String   @map("file_name")
  filePath    String   @map("file_path")
  fileType    String   @map("file_type")
  fileSize    Int      @map("file_size")
  description String?
  sourceStudentName String? @map("source_student_name")
  sourceStudentNo   String? @map("source_student_no")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, relatedType, relatedId])
  @@map("attachments")
}

model TimelineEvent {
  id          Int      @id @default(autoincrement())
  studentId   Int      @map("student_id")
  relatedType String   @map("related_type")
  relatedId   Int      @map("related_id")
  eventType   String   @map("event_type")
  title       String
  description String?
  eventDate   DateTime @map("event_date")
  createdAt   DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("timeline_events")
}

model PaperResponsibilityTransfer {
  id            Int       @id @default(autoincrement())
  paperId       Int       @map("paper_id")
  fromStudentId Int       @map("from_student_id")
  toStudentId   Int       @map("to_student_id")
  transferredAt DateTime? @map("transferred_at")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  paper       Paper   @relation(fields: [paperId], references: [id], onDelete: Cascade)
  fromStudent Student @relation("TransferFrom", fields: [fromStudentId], references: [id], onDelete: Restrict)
  toStudent   Student @relation("TransferTo", fields: [toStudentId], references: [id], onDelete: Restrict)

  @@unique([paperId, fromStudentId, toStudentId])
  @@index([fromStudentId])
  @@index([toStudentId])
  @@map("paper_responsibility_transfers")
}

model PromptTemplate {
  id        Int      @id @default(autoincrement())
  teacherId Int      @map("teacher_id")
  name      String
  taskType  String   @map("task_type")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, taskType])
  @@map("prompt_templates")
}

model AiTaskRun {
  id               Int      @id @default(autoincrement())
  teacherId        Int      @map("teacher_id")
  paperId          Int?     @map("paper_id")
  submissionId     Int?     @map("submission_id")
  revisionId       Int?     @map("revision_id")
  taskType         String   @map("task_type")
  templateKey      String?  @map("template_key")
  templateName     String?  @map("template_name")
  promptText       String   @map("prompt_text")
  packageText      String   @map("package_text")
  supplementalText String?  @map("supplemental_text")
  resultText       String?  @map("result_text")
  resultStatus     String   @default("draft") @map("result_status")
  rawResult        String?  @map("raw_result")
  parsedJson       String?  @map("parsed_json")
  acceptedJson     String?  @map("accepted_json")
  materialJson     String?  @map("material_json")
  parseWarningsJson String? @map("parse_warnings_json")
  parsedAt         DateTime? @map("parsed_at")
  acceptedAt       DateTime? @map("accepted_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  teacher    Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  paper      Paper?      @relation(fields: [paperId], references: [id], onDelete: SetNull)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  revision   Revision?   @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  @@index([teacherId, taskType])
  @@index([revisionId, createdAt])
  @@map("ai_task_runs")
}
